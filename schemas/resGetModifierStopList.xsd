<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="RK7QueryResult">
    <xs:annotation>
      <xs:documentation xml:lang="ru">xml-ответ GetModifierStopList</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="RK7QueryResult">
          <xs:sequence>
            <xs:element name="Modifier" type="resRefItem" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Модификатор</xs:documentation>
              </xs:annotation>
              <xs:element name="Reason" type="resRefItem" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Причина добавления модификатора в стоп-лист</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:element>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
