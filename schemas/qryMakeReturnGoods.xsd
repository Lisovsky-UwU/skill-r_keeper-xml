<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:complexType name="roDishItem">
        <xs:attribute name="line_guid" type="xs:normalizedString" use="optional">
          <xs:annotation>
            <xs:documentation xml:lang="ru">LINE_GUID блюда</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="quantity" type="xs:int" use="required">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Количество блюда (в тысячных долях)</xs:documentation>
          </xs:annotation>
        </xs:attribute>    
  </xs:complexType>  
  <xs:complexType name="roPrintCheckItem">
    <xs:attribute name="line_guid" type="xs:normalizedString" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">GUID чека</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="roOrder">
    <xs:attribute name="guid" type="xs:normalizedString" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">GUID заказа</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="poFiscalDocInfo">
    <xs:sequence>
      <xs:element name="FiscDev" type="refItem" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Тип фискального устройства. 
Указанное значение заносится в поле PrintChecks.FiscDev</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="PrintNumber" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Печатный номер чека, в России номер чека ФН. 
Указанное значение заносится в поле PrintChecks.PrintNumber.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="DeleteFiscDocNumber" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Фискальный номер документа, в России номер документа ФН. 
Указанное значение заносится в поле PrintChecks.DeleteFiscDocNumber.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="GlobalFiscalId" type="xs:normalizedString" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Глобальный номер чека, в России не используется.
Указанное значение заносится в поле PrintChecks.GlobalFiscalID.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ExtFiscID" type="xs:normalizedString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Номер фискального регистратора. 
Указанное значение заносится в поле PrintChecks.ExtFiscID.  
          </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="FiscShiftNum" type="xs:positiveInteger" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Номер фискальной смены фискального регистратора. 
Указанное значение заносится в поле PrintChecks.iFiscShift.  
          </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>  
  <xs:element name="RK7Query">
    <xs:annotation>
      <xs:documentation xml:lang="ru">[Кассовый сервер] Возврат товара</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element name="RK7CMD">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="LicenseInfo" type="LicenseInfoItem" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Информация о лицензии, необходимой для выполнения запроса</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="MobileLicenseInfo" type="MobileLicenseInfoItem" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Информация о лицензии мобильного официанта, необходимой для выполнения запроса</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Station" type="refItem" minOccurs="1">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Станция</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Cashier" type="refItem" minOccurs="1">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Кассир</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Reason" type="refItem" minOccurs="1">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Причина (удаления) для возврата блюд</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ReceiptMaket" type="refItem" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Представление документа для возврата товара</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="OrderType" type="resRefItem" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Тип заказа</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="PrintCheck" type="roPrintCheckItem" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Исходный чек, блюдо из которого нужно вернуть, идентифицируется line_guid</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Order" type="roOrder" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Заказ, из которого нужно вернуть блюдо. Используется только в случае, если не указан чек. Если в заказе более 1 чека, то возврат с указанием только guid заказа осуществить нельзя</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Dishes" minOccurs="1">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Список блюд для возврата</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                <xs:sequence>
                  <xs:element type="roDishItem" name="Dish" minOccurs="1" maxOccurs="unbounded"/>
                </xs:sequence>
              </xs:complexType>                
              </xs:element>
              <xs:element name="ExternalProps" type="externalProps" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Список внешних свойств заказа</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="FiscalDocInfo" type="poFiscalDocInfo" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Информация о фискальном документе. Для использования в отчетах.</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>            
            <xs:attribute name="CMD" fixed="MakeReturnGoods"/>
            <xs:attribute name="persistentComment" type="xs:normalizedString">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Сохраняемый комментарий заказа</xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <xs:attribute name="nonPersistentComment" type="xs:normalizedString">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Несохраняемый комментарий заказа</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
