<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="RK7Query">
    <xs:annotation>
      <xs:documentation xml:lang="ru">[Кассовый сервер] Удалить партию товара</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:element name="RK7CMD">
        <xs:complexType>
          <xs:all>
            <xs:element name="Manager" type="refItem" minOccurs="1">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Менеджер</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="Station" type="refItem" minOccurs="1">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Станция</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
          <xs:attribute name="CMD" fixed="DeleteBatchOfGoods"/>
          <xs:attribute name="data" type="xs:base64binary" use="required">
            <xs:annotation>
              <xs:documentation xml:lang="ru">Данные марки в base64</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="quantity" type="xs:int" use="required">
            <xs:annotation>
              <xs:documentation xml:lang="ru">Количество товара в партии (в тысячных долях)</xs:documentation>
            </xs:annotation>
          </xs:attribute>    
        </xs:complexType>
      </xs:element>
    </xs:complexType>
  </xs:element>
</xs:schema>
