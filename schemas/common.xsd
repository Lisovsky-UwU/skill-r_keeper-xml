                  <xs:documentation xml:lang="ru">Компонент, в котором была сгенерирована ошибка</xs:documentation>
                </xs:annotation>
              </xs:attribute>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RK7QueryResult">
    <xs:sequence>
      <xs:element name="Errors" type="ErrorStack" minOccurs="0" maxOccurs="1">
      </xs:element>
    </xs:sequence>
    <xs:attribute name="ServerVersion" type="xs:normalizedString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Версия кассовой программы</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="XmlVersion" type="xs:positiveInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Версия xml протокола</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="NetName" type="xs:token">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Сетевое имя программы (с 7.5.3.260)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="CMD" type="xs:token">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Исходная xml-команда</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Status" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Статус выполнения запроса</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:normalizedString">
          <xs:enumeration value="Ok"/>
          <xs:enumeration value="No changes"/>
          <xs:enumeration value="Execution Started"/>
          <xs:enumeration value="Query Parse Error"/>
          <xs:enumeration value="Bad Query Parameters"/>
          <xs:enumeration value="Query Executing Error"/>
          <xs:enumeration value="Result Writing Error"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="RK7ErrorN" type="xs:positiveInteger" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Код ошибки RK7</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ErrorText" type="xs:normalizedString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Текст ошибки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="WorkTime" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время обработки запроса (в
                    миллисекундах)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="DateTime" type="xs:dateTime" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Дата и время генерации ответного xml
                    (xmlver&gt;=39)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Processed" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Количество обработанных команд</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="deliveryBlock">
    <xs:attribute name="deliveryState" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Статус доставки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="startTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время создания заказа</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="travelTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время в пути</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="deliveryTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Ожидаемое время доставки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="forwarderSendTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время отправки экспедитора</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="forwarderReturnTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время возвращения экспедитора</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="realDeliveryTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Реальное время доставки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lastProcessTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время последней обработки заказа. Заполняет Delivery</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="minCookTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Минимальное время приготовления заказа</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoneID" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="ru">ID зоны доставки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoneName" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Имя зоны доставки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="orderPrefix" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Префиск для имени заказа</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="isTakeOut" type="xs:boolean">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Флаг - доставка на вынос. Если флаг выставлен, то
                    статусами доставки на филиале управляет RK7</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoChangeState" type="xs:boolean">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Флаг - разрешение автоматического изменения статусов доставки в rk7</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="invoiceItem">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Счет/фактура</xs:documentation>
    </xs:annotation>
    <xs:attribute name="guid" type="guidString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">GUID счет/фактуры</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="regno" type="xs:normalizedString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">ИНН</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:normalizedString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Наименование</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="address" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Адрес</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extrainfo" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Доп.инфо</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="comment" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Комментарий</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="resOperationItem">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Операция</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Station" type="resRefItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Станция операции</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="OperationType" type="resRefItem" minOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Тип операции</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Operator" type="resEmployeeItem" minOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Оператор - основной зарегистрированный работник</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Manager" type="resEmployeeItem" minOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Менеджер - работник, подтвердивший операцию</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Order" type="resOrderElement" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">заказ операции</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="MenuItem" type="resRefItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Элемент меню, заполнен для операций над блюдом</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Maket" type="refItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Представление печати документа для операции печати</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Reason" type="resEmployeeItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">причина (внесения-выдачи, удаления,...)</xs:documentation>
        </xs:annotation>
      </xs:element>  
    </xs:sequence>
    <xs:attribute name="id" type="xs:positiveInteger">
      <xs:annotation>
        <xs:documentation xml:lang="ru">id операции (уникальный в рамках кассового сервера)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="commonShiftNum" type="xs:positiveInteger" use="optional"/>  
    <xs:attribute name="dateTime" type="xs:dateTime">
      <xs:annotation>
        <xs:documentation xml:lang="ru">ДатаВремя операции в формате ISO</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="parameter" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="ru">целочисленный параметр операции</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="quantity" type="xs:int" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Количество блюда в тысячных долях, если операция не относится к блюду, то 0 или отсутствует</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="orderSumBefore" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Сумма заказа (в копейках) до выполнения операции</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="orderSumAfter" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Сумма заказа (в копейках) после выполнения операции</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="extData">
    <xs:attribute name="clientinfoinput" type="xs:normalizedString"/>
    <xs:attribute name="tag" type="xs:normalizedString"/>
  </xs:complexType>
  <xs:complexType name="extCardProperty">
    <xs:attribute name="name" type="xs:normalizedString" use="required"/>
    <xs:attribute name="value" type="xs:normalizedString"/>
  </xs:complexType>
  <xs:complexType name="extCardProperties">
    <xs:sequence>
      <xs:element name="Property" type="extCardProperty" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="LicenseInstanceItem">
    <xs:attribute name="guid" type="guidString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Генерируется клиентом один раз при инсталляции или первом запуске приложения/инстанса как настоящий уникальный GUID и сохраняется. Количество разных значений в течении суток ограничено и связано с количеством подключений в лицензии.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="seqNumber" type="xs:nonNegativeInteger" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">При первом вызове для конкретного guid должно быть 0, в дальнейшем каждый следующий вызов на 1 больше, можно повторить идентичный запрос (с там же seqNumber), ответ может кэшироваться RK7 (заново не обязан вычисляться)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="LicenseInfoItem">
    <xs:sequence>
      <xs:element name="LicenseInstance" type="LicenseInstanceItem" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="anchor" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">формат якоря:  6:_ProductGUID_#_RestCode_/17, где _ProductGUID_ - GUID продукта, сообщается UCS, _RestCode_ - 9-значный код ресторана</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="licenseToken" type="xs:normalizedString">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Токен лицензии запрашивается у системы лицензирования, инструкции по обращению к системе лицензирования за токеном лицензии сообщаются UCS вместе с GUID продукта</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="MobileLicenseInstanceItem">
    <xs:complexContent>
      <xs:extension base="LicenseInstanceItem">
        <xs:attribute name="name" type="xs:normalizedString">
          <xs:annotation>
            <xs:documentation xml:lang="ru">имя инстанса</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:simpleType name="MobileLicenseKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="waiter"/>
      <xs:enumeration value="administrator"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="MobileLicenseInfoItem">
    <xs:sequence>
      <xs:element name="LicenseInstance" type="MobileLicenseInstanceItem" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="kind" type="MobileLicenseKind">
      <xs:annotation>
        <xs:documentation xml:lang="ru">тип лицензии (официант/админ)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="TimeoutItem">
    <xs:attribute name="value" type="xs:nonNegativeInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Время в милисекундах, за которое должна выполниться операция или вернуть ошибку</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:simpleType name="errorArea">
    <xs:restriction base="xs:normalizedString">
      <xs:enumeration value="Printer"/>
      <xs:enumeration value="Authorization terminal"/>
      <xs:enumeration value="PDS"/>
      <xs:enumeration value="Rights"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="ErrorItem">
    <xs:all>
      <xs:element name="FaultyTag">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Сбойный тэг</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:any processContents="lax" minOccurs="1" maxOccurs="1">
              <xs:annotation>
                <xs:documentation xml:lang="ru">xml тэг, породивший
                                    ошибку</xs:documentation>
              </xs:annotation>
            </xs:any>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="RK7ErrorN" type="xs:positiveInteger" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Код ошибки RK7</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="Component" type="errorArea" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Компонент, в котором была сгенерирована ошибка</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ErrorText" type="xs:normalizedString" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Текст ошибки</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="resBottle">
      <xs:sequence>
        <xs:element name="Author" type="refItem" minOccurs="1" maxOccurs="1">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Работник, вскрывший бутылку</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Station" type="refItem" minOccurs="1" maxOccurs="1">
          <xs:annotation>
            <xs:documentation xml:lang="ru">Станция, на которой была вскрыта бутылка</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="markingData" type="xs:base64Binary" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Марка PDF-417 в формате base64</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="ean" type="xs:long" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="ru">EAN марка</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="startDateTime" type="xs:dateTime" use="optional">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Дата-время добавления записи</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="bottleVolume" type="xs:integer" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Объем бутылки</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="restVolume" type="xs:integer" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Остаток в бутылке</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="isOldRest" type="xs:boolean" use="required">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Признак того, что бутылка уже была вскрытой</xs:documentation>
        </xs:annotation>
      </xs:attribute>
  </xs:complexType>

</xs:schema>