<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="RK7Query">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Создание якоря лояльности на основе содержимого для конкретного заказа</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element name="RK7CMD">
          <xs:complexType>
            <xs:all>
              <xs:element name="Order" type="orderElement" minOccurs="1">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Заказ</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:all>
            <xs:attribute name="CMD" fixed="CreaterkFriendsAnchor"/>
            <xs:attribute name="phone" type="xs:normalizedString" use="optional">
              <xs:annotation>
                <xs:documentation xml:lang="ru">номер телефона участника лояльности</xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <xs:attribute name="token" type="xs:normalizedString" use="optional">
              <xs:annotation>
                <xs:documentation xml:lang="ru">токен идентификации участника лояльности</xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
