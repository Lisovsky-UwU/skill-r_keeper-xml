<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  
  <xs:element name="RK7Query">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Проверка статуса отправки данных по кегу в Честный Знак</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:all>
        <xs:element name="RK7CMD">
          <xs:complexType>
            <xs:all>
              <xs:element name="Keg">
                <xs:annotation>
                  <xs:documentation xml:lang="ru">Кег</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:attribute name="markingData" type="xs:base64Binary" use="required">
                    <xs:annotation>
                      <xs:documentation xml:lang="ru">Марка кега в base64</xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:all>
            <xs:attribute name="CMD" fixed="LowAlcKegStatus"/>
          </xs:complexType>
        </xs:element>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
