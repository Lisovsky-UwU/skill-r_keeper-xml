<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="RK7Query">
    <xs:annotation>
      <xs:documentation xml:lang="ru">[Кассовый сервер] Удалить модификатор из стоп-листа</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:element name="RK7CMD">
        <xs:complexType>
          <xs:all>
            <xs:element name="Modifier" type="refItem" minOccurs="1" maxOccurs="1">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Модификатор, удаляемый из стоп-листа</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:all>
          <xs:attribute name="CMD" fixed="DeleteModifierFromStopList"/>
        </xs:complexType>
      </xs:element>
    </xs:complexType>
  </xs:element>
</xs:schema>
