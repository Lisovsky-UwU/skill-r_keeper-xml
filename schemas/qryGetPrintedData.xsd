<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:include schemaLocation="unifr.xsd"/>
  <xs:complexType name="GetPrintedData">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Получить список распечатанных документов</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="OperationType" type="refItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Тип операции к которой привязан распечатанный документ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Station" type="refItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Станция принтера, через которую печатался документ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Device" type="refItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Логический принтер, на котором был распечатан документ</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Document" type="refItem" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Тип распечатанного документа</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Order" type="orderElement" minOccurs="0">
        <xs:annotation>
          <xs:documentation xml:lang="ru">Заказ, к которому относится распечатанный документ</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="operationId" type="xs:positiveInteger" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">ID операции, ссылка на OperationLog.Sifr, по которой печатался документ</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="objUNI" type="xs:positiveInteger" use="optional">
      <xs:annotation>
        <xs:documentation xml:lang="ru">UNI объекта, по которому печатался документ, для чека UNI чека</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="CMD" fixed="GetPrintedData"/>
    <xs:attribute name="Timeout" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation xml:lang="ru">Таймаут ожидания готовности устройства, при 0 асинхронная отправка в очередь без ошибок</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="RK7Query">
    <xs:annotation>
      <xs:documentation xml:lang="ru">Печать пользовательского документа</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="1" maxOccurs="1">
        <xs:element name="RK7CMD" type="GetPrintedData"/>
        <xs:sequence>
          <xs:element name="RK7Command" type="GetPrintedData" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:sequence>
          <xs:element name="RK7Command2" type="GetPrintedData" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>
