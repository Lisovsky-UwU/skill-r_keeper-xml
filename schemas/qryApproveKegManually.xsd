<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="common.xsd"/>
	<xs:element name="RK7Query">
		<xs:annotation>
			<xs:documentation xml:lang="ru">Ручная постановка ошибочного кега со слабоалкогольным напитком на кран</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="RK7CMD">
					<xs:complexType>
						<xs:all>
							<xs:element name="Keg">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Кег</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:attribute name="markingData" type="xs:base64Binary" use="required">
										<xs:annotation>
											<xs:documentation xml:lang="ru">Марка кега в base64</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="bottleVolume" type="xs:positiveInteger" use="required">
										<xs:annotation>
											<xs:documentation xml:lang="ru">Объем кега в миллилитрах</xs:documentation>
										</xs:annotation>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
							<xs:element name="Author" type="refItem" minOccurs="0">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Автор операции</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Station" type="refItem" minOccurs="1">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Станция</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
						<xs:attribute name="CMD" fixed="ApproveKegManually"/>
					</xs:complexType>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
</xs:schema>
