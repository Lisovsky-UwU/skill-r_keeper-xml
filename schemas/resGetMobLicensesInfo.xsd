<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:complexType name="ResMobLicenseInstanceItem">
      <xs:attribute name="guid" type="guidString"/>
      <xs:attribute name="name" type="xs:normalizedString">
        <xs:annotation>
          <xs:documentation xml:lang="ru">имя инстанса</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="slot" type="xs:nonNegativeInteger">
        <xs:annotation>
          <xs:documentation xml:lang="ru">номер слота лицензии</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dateTime" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="ru">ДатаВремя создания инстанса</xs:documentation>
        </xs:annotation>
      </xs:attribute>
  </xs:complexType>
  <xs:complexType name="ResMobLicenseKindInfo">
    <xs:all>
      <xs:element name="Instances">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Instance" type="ResMobLicenseInstanceItem" minOccurs="1" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:all>
    <xs:attribute name="kind" type="MobileLicenseKind">
      <xs:annotation>
        <xs:documentation xml:lang="ru">тип лицензии (официант/админ)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="available" type="xs:nonNegativeInteger">
      <xs:annotation>
        <xs:documentation xml:lang="ru">максимальное количество инстансов</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="MobLicensesInfoItem">
    <xs:sequence>
      <xs:element name="MobLicenseInfo" type="ResMobLicenseKindInfo" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="RK7QueryResult">
    <xs:annotation>
      <xs:documentation xml:lang="ru">[Кассовый сервер] xml-ответ на получение номера запроса по инстансу</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="RK7QueryResult">
          <xs:sequence>
            <xs:element name="MobLicensesInfo" type="MobLicensesInfoItem">
              <xs:annotation>
                <xs:documentation xml:lang="ru">Информация о лицензиях и инстансах для мобильного официанта</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>

