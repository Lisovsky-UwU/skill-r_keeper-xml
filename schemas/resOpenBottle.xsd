<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="common.xsd"/>
  <xs:element name="RK7QueryResult">
    <xs:annotation>
      <xs:documentation xml:lang="ru">xml-ответ: OpenBottlet</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="RK7QueryResult">
          <xs:sequence>
            <xs:element name="Bottle" minOccurs="0" maxOccurs="1">
              <xs:complexType>
                <xs:attribute name="name" type="xs:normalizedString">
                  <xs:annotation>
                    <xs:documentation xml:lang="ru">наименование бутылки (из ЕГАИС)</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
                <xs:attribute name="bottleVolume" type="xs:nonNegativeInteger">
                  <xs:annotation>
                    <xs:documentation xml:lang="ru">объём бутылки в миллилитрах</xs:documentation>
                  </xs:annotation>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
