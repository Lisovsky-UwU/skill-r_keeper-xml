<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="common.xsd"/>
	<xs:element name="RK7Query">
		<xs:annotation>
			<xs:documentation xml:lang="ru">[Кассовый сервер] Поставить тарификацию на паузу</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="RK7CMD">
					<xs:complexType>
						<xs:all>
							<xs:element name="Order" type="orderElement" minOccurs="1">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Заказ</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Manager" type="refItem" minOccurs="0">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Менеджер</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Station" type="refItem" minOccurs="0">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Станция</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Device" type="refItem" minOccurs="1">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Тарифицируемое устройство (стол)</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="TariffType" type="refItem" minOccurs="1">
								<xs:annotation>
									<xs:documentation xml:lang="ru">Детализация тарификации, определяющая продолжительность паузы</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:all>
						<xs:attribute name="CMD" fixed="PauseTariff"/>
						<xs:attribute name="lockguid" type="xs:normalizedString">
							<xs:annotation>
								<xs:documentation xml:lang="ru">Токен блокировки (идентификатор сессии блокировки)</xs:documentation>
							</xs:annotation>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
</xs:schema>
